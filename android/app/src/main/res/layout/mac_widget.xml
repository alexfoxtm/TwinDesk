<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_mac_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mac_widget_background"
    android:gravity="top"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <TextView
        android:id="@+id/widget_mac_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/mac_widget_label"
        android:textColor="#F2F4FB"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_mac_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:includeFontPadding="false"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#BBC5DB"
        android:textSize="13sp" />

    <Button
        android:id="@+id/widget_mac_action"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:backgroundTint="#CAD7FF"
        android:includeFontPadding="false"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAllCaps="false"
        android:textColor="#172955"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>

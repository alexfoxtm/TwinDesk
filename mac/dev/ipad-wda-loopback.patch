diff --git a/WebDriverAgentLib/Routing/FBWebServer.m b/WebDriverAgentLib/Routing/FBWebServer.m
index 78200ace..6162498b 100644
--- a/WebDriverAgentLib/Routing/FBWebServer.m
+++ b/WebDriverAgentLib/Routing/FBWebServer.m
@@ -10,0 +11,4 @@
+#include <arpa/inet.h>
+#include <ifaddrs.h>
+#include <net/if.h>
+
@@ -28,0 +33,31 @@
+static BOOL FBTwinDeskIsLocalEndpoint(NSString *address)
+{
+  if ([address isEqualToString:@"127.0.0.1"]) {
+    return YES;
+  }
+  struct in6_addr expected;
+  if (address.length == 0 || inet_pton(AF_INET6, address.UTF8String, &expected) != 1 ||
+      expected.s6_addr[0] != 0xfd || expected.s6_addr[15] != 1) {
+    return NO;
+  }
+  struct ifaddrs *interfaces = NULL;
+  if (getifaddrs(&interfaces) != 0) {
+    return NO;
+  }
+  BOOL found = NO;
+  const unsigned int required = IFF_UP | IFF_POINTOPOINT;
+  for (const struct ifaddrs *entry = interfaces; entry != NULL; entry = entry->ifa_next) {
+    if (entry->ifa_addr == NULL || entry->ifa_addr->sa_family != AF_INET6 ||
+        (entry->ifa_flags & required) != required || strncmp(entry->ifa_name, "utun", 4) != 0) {
+      continue;
+    }
+    const struct sockaddr_in6 *local = (const struct sockaddr_in6 *)entry->ifa_addr;
+    if (IN6_ARE_ADDR_EQUAL(&expected, &local->sin6_addr)) {
+      found = YES;
+      break;
+    }
+  }
+  freeifaddrs(interfaces);
+  return found;
+}
